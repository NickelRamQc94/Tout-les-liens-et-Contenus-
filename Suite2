]

def calculate_ioc(text):
    """
    Calcule l'Indice de Coïncidence (IC) du texte.
    Formule : IC = Somme(f_i * (f_i - 1)) / (N * (N - 1))
    où f_i est la fréquence d'apparition de chaque rune et N la longueur du texte.
    """
    n = len(text)
    if n <= 1:
        return 0.0
    
    freqs = Counter(text)
    ic_numerator = sum(f * (f - 1) for f in freqs.values())
    ic_denominator = n * (n - 1)
    
    return ic_numerator / ic_denominator

def find_repeated_ngrams(text, length=3):
    """
    Trouve les séquences de runes répétées (n-grammes) et leurs positions
    pour exécuter le test de Kasiski.
    """
    ngrams = {}
    for i in range(len(text) - length + 1):
        ngram = text[i:i+length]
        if ngram not in ngrams:
            ngrams[ngram] = []
        ngrams[ngram].append(i)
    
    # Filtrer pour ne garder que ceux qui se répètent
    repeated = {k: v for k, v in ngrams.items() if len(v) > 1}
    return repeated

def get_distances(positions):
    """Calcule les distances entre les apparitions d'un même n-gramme."""
    distances = []
    for i in range(len(positions) - 1):
        distances.append(positions[i+1] - positions[i])
    return distances

def get_factors(number):
    """Trouve les facteurs d'un nombre pour déterminer la longueur de la clé."""
    factors = set()
    for i in range(2, int(math.sqrt(number)) + 1):
        if number % i == 0:
            factors.add(i)
            factors.add(number // i)
    factors.add(number)
    return sorted(list(factors))

