def turbulo_turnibulo_tensor(theta: float, delta: float, rho_k: float) -> np.ndarray:
omega_x = rho_k \* math.cos(theta) \* math.sin(delta)

omega_y = rho_k \* math.sin(theta) \* math.sin(delta)

omega_z = rho_k \* math.cos(delta)

return np.array(\[

    \[0.0,      -omega_z,  omega_y\],

    \[omega_z,   0.0,     -omega_x\],

    \[-omega_y,  omega_x,  0.0    \]

\], dtype=float)

