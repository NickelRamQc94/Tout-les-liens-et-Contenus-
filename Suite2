2.2 Fonction TAT²S adaptative

\`\`\`python

def build\_TAT2S\_atomic(aidn\_i, aidn\_j, bond\_type=None, v\_flow=np.zeros(3)):

"""

Si bond\_type == 'covalent' : énergie dominante avec spin aligné.

Si 'hbond' : terme azimutal fort, viscosité réduite.

Sinon (empilement) : viscosité standard.

"""

r\_vec = aidn\_j.pos - aidn\_i.pos

r = np.linalg.norm(r\_vec)

if r &lt; 1e-9:

return np.zeros((6,6,6,6))

n = np.zeros(6)

n\[0\] = 1.0

n\[1:4\] = r\_vec / r

phi\_prod = aidn\_i.phi \* aidn\_j.phi

\# Base commune

A = np.zeros((6,6,6,6))

T\_turb = np.zeros((6,6,6,6))

W = np.zeros((6,6,6,6))

if bond\_type == 'covalent':

\# Spin fortement couplé : A dominant

for a in range(3):

A\[a+1, 4, a+1, 4\] = 0.5 # diagonale renforcée

\# Viscosité très faible (liaison rigide)

nu\_eff = Constants.NU\_INFO \* 0.01

elif bond\_type == 'hbond':

\# Terme azimutal spécifique : alignement des spins selon l'axe donneur-accepteur

\# On suppose que le spin de l'accepteur (O,N) est dirigé vers le donneur

spin\_dir = aidn\_j.spin - aidn\_i.spin

for a in range(3):

A\[a+1, 4, a+1, 5\] = 0.2 \* spin\_dir\[a\] # couplage angulaire

nu\_eff = Constants.NU\_INFO \* 0.1

else: # stacking

nu\_eff = Constants.NU\_INFO

\# Viscosité

v\_norm = np.linalg.norm(v\_flow) + 1e-12

Re = nu\_eff \* r / v\_norm

for i in range(3):

for j in range(3):

T\_turb\[0, i+1, 0, j+1\] = nu\_eff \* ((1.0 if i==j else 0.0) +

2.0/Re \* v\_flow\[i\]\*v\_flow\[j\] / v\_norm\*\*2)

\# Torsion nickel

S = 0.01 \* Constants.NICKEL

W\[1,2,1,2\] = S

W\[1,2,2,1\] = -S

W\[2,1,1,2\] = -S

W\[2,1,2,1\] = S

return phi\_prod \* (A + T\_turb + W)

\`\`\`

L’énergie d’interaction entre deux atomes est toujours E = contract\_TAT2S\_energy(T, n) / r\*\*2.

