def get_effective_viscosity(self, gamma_dot, T_kelvin=503.15): 
eta_base = self.K * (gamma_dot ** (self.n - 1)) * math.exp(self.Ea / (self.R * T_kelvin)) 
return eta_base / NI_RESONANCE 
