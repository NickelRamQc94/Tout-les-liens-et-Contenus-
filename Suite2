def fibonacci(n: int) -> int:
if n \&lt;= 0:

    return 0

if n == 1:

    return 1

a, b = 0, 1

for \_ in range(2, n + 1):

    a, b = b, a + b

return b

def fibonicci_ratio(k: int) -> float:
phi = (1.0 + math.sqrt(5.0)) / 2.0

fk = fibonacci(k)

fk1 = fibonacci(k + 1)

return phi \* (fk / fk1)

