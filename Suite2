Extraction Automatisée de Contenu Web pour Investigations
import requests
from bs4 import BeautifulSoup
import time
# Ta liste des 102 liens (j'en mets 3 pour l'exemple)
urls = [
"https://github.com/OpenNotebook/OpenNotebook",

"https://github.com/deepseek-ai/DeepSeek-R1",

"https://meridian.ai"

]
fichier_sortie = "Base_Investigation_Liens.md"
with open(fichier_sortie, "w", encoding="utf-8") as f:
for url in urls:

    print(f"Extraction de : {url}")

    try:

        \# Astuce pour les liens GitHub : pointer vers le rawusercontent pour chopper le README direct

        if "github.com" in url and "raw" not in url:

            url_raw = url.replace("github.com", "raw.githubusercontent.com") + "/main/README.md"

            response = requests.get(url_raw, timeout=10)

        else:

            response = requests.get(url, timeout=10)


        \# Nettoyage du HTML si ce n'est pas du Markdown

        soup = BeautifulSoup(response.text, 'html.parser')

        texte_propre = soup.get_text(separator='\\n', strip=True)


        \# Écriture dans le fichier maître

        f.write(f"# Source Extraite : {url}\\n\\n")

        f.write(texte_propre\[:10000\]) # On limite la taille par site pour ne pas exploser le contexte

        f.write("\\n\\n---\\n\\n")


        time.sleep(2) # Pause de 2 secondes pour éviter de se faire bloquer (rate limit)


    except Exception as e:

        f.write(f"# Échec d'extraction pour {url} : {str(e)}\\n\\n---\\n\\n")

        print(f"Erreur sur {url}")

print(f"Terminé. Les données sont dans {fichier_sortie}")
