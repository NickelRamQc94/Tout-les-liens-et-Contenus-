"""

Script : PDB\_to\_HapticVR.py

Extrait les coordonnées atomiques d'un fichier PDB (ex: capside de phage),

convertit en maillage surfacique et génère une carte de friction haptique

basée sur l'énergie de liaison locale (Delta G simplifié).

"""

import numpy as np

from scipy.spatial import ConvexHull

from scipy.spatial.distance import pdist, squareform

\# Constantes

CONSTANTE\_NICKEL = 1.094722

RAYON\_SOLVANT = 1.4 # Å

def parse\_pdb(filename):

atoms = []
with open(filename, 'r') as f:
for line in f:

    if line.startswith("ATOM"):

        x = float(line\[30:38\])

        y = float(line\[38:46\])

        z = float(line\[46:54\])

        atom_type = line\[76:78\].strip()

        atoms.append((x, y, z, atom_type))
return np.array(atoms)

def estimate\_haptic\_friction(atoms):

"""
Calcule une pseudo-énergie de liaison locale basée sur
les distances inter-atomiques et la constante Nickel.
Renvoie un tableau de friction par atome.
"""
coords = atoms[:, :3].astype(float)
dist_matrix = squareform(pdist(coords))
# Friction proportionnelle à l'inverse de la distance moyenne aux voisins
friction = np.zeros(len(atoms))
for i in range(len(atoms)):
neighbors = dist_matrix\[i\]\[dist_matrix\[i\] \&gt; 0\]

if len(neighbors):

    mean_dist = np.mean(neighbors\[:12\])  # premiers voisins

    \# Si trop éloigné (\&gt; 4 Å) =\&gt; instable =\&gt; haute friction

    friction\[i\] = np.exp(-mean_dist / RAYON_SOLVANT) \* CONSTANTE_NICKEL
return friction

def generate\_mesh(atoms, friction):

"""
Crée un maillage convexe (coque) pour représenter la protéine en VR.
Retourne les vertices et une couleur par vertex selon la friction.
"""
coords = atoms[:, :3].astype(float)
hull = ConvexHull(coords)
vertices = coords[hull.vertices]
# Couleurs : vert (stable) à rouge (haute friction)
colors = []
max_f = max(friction) if max(friction) &gt; 0 else 1
for f in friction[hull.vertices]:
ratio = min(f / max_f, 1.0)

colors.append((ratio, 1.0 - ratio, 0.0))  # RGB
return vertices, hull.simplices, colors

\# Exemple d'utilisation

if \_*name*\_ == "\_*main*\_":

atoms = parse_pdb("capsid_T4.pdb")
friction = estimate_haptic_friction(atoms)
verts, faces, colors = generate_mesh(atoms, friction)
# Export pour Unity/Unreal (fichier .obj + métadonnées haptiques)
np.savetxt("capsid_verts.obj", verts)
np.savetxt("capsid_faces.txt", faces, fmt='%d')
np.savetxt("capsid_haptics.txt", friction)
print("Maillage haptique généré. Prêt pour le Vortex VR.")

