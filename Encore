import numpy as np
class JeffreysMaterial:
def \__init_\_(self, eta_0, lambda_1, lambda_2, G_inf):

self.eta_0 = eta_0 # viscosité à cisaillement nul

self.lambda_1 = lambda_1 # temps de relaxation

self.lambda_2 = lambda_2 # temps de retard

