def compute\_pair\_energy(aidns\_A, aidns\_T, hbonds, v\_flow=np.zeros(3)):

E = 0.0

\# Interactions entre tous les atomes (dans un rayon raisonnable)

for a in aidns\_A:

for t in aidns\_T:

r = np.linalg.norm(t.pos - a.pos)

if r &gt; 0.5: continue # au-delà de 5 Å, négligeable

bond = 'hbond' if (a.label, t.label) in hbonds else None

T = build\_TAT2S\_atomic(a, t, bond, v\_flow)

E += contract\_TAT2S\_energy(T, compute\_n(a,t)) / r\*\*2

return E

E\_A\_T = compute\_pair\_energy(adenine\_aidns, thymine\_aidns, hbonds)

print(f"Énergie paire A-T avec NICKEL={Constants.NICKEL} : {E\_A\_T:.4e} J")

\# Cible : 10.5 kJ/mol = 1.74e-20 J par paire

