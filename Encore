def cartesian_to_spherical(r: np.ndarray) -> tuple[float, float, float]:
x, y, z = r

radius = math.sqrt(x \* x + y \* y + z \* z)

if radius == 0.0:

    return 0.0, 0.0, 0.0

theta = math.atan2(y, x)          # azimut

delta = math.acos(z / radius)     # pendage

return radius, theta, delta

