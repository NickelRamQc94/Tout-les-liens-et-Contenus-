                A[i,4,j,4] += 0.1 * s[k]  # epsilon_ijk s_k
    
    # Secteur Turbulo
    T_turb = np.zeros((6,6,6,6))
    Re_info = nu_info * r / (np.linalg.norm(v_flow) + 1e-9)
    for i in range(3):
        for j in range(3):
            T_turb[0,i,0,j] = nu_info * ( (i==j) + 2.0/Re_info * v_flow[i]*v_flow[j] )
    
    # Secteur Turnibulo (torsion constante)
    W = np.zeros((6,6,6,6))
    # Torsion S^rho_{mu nu} non nulle pour mu,nu=1,2
    S = 0.01 * N_c  # amplitude
    W[1,2,1,2] = S
    W[1,2,2,1] = -S
    
    # Tenseur complet
    TAT2S = A + T_turb + W  # Secteur Subtendien implicite dans la métrique
    return TAT2S, n

